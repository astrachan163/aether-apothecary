# Copy to .env.local and fill in your own values. Never commit .env.local.
# Leave every value in this file blank.

# Server-only admin gate. The browser never receives this value.
ADMIN_PASSWORD=

# Stripe secret key. Used only by src/app/api/checkout/route.ts.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. The webhook route does not read this yet.
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key. Public by design. The product page does not use it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Admin SDK. Unused while src/lib/firebase.ts is a stub.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
